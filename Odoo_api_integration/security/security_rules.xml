<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Grupo para gestión de API -->
        <record id="group_api_manager" model="res.groups">
            <field name="name">API Manager</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <!-- Reglas de seguridad simplificadas para API Keys -->
        <record id="rule_api_key_user" model="ir.rule">
            <field name="name">API Key User Restriction</field>
            <field name="model_id" ref="model_api_integration_key"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <!-- Reglas de seguridad simplificadas para API Logs -->
        <record id="rule_api_log_user" model="ir.rule">
            <field name="name">API Log User Restriction</field>
            <field name="model_id" ref="model_api_integration_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <!-- Regla multi-compañía para API Keys -->
        <record id="rule_api_key_multi_company" model="ir.rule">
            <field name="name">API Key Multi-Company</field>
            <field name="model_id" ref="model_api_integration_key"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_multi_company'))]"/>
        </record>
        
        <!-- Regla multi-compañía para API Logs -->
        <record id="rule_api_log_multi_company" model="ir.rule">
            <field name="name">API Log Multi-Company</field>
            <field name="model_id" ref="model_api_integration_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_multi_company'))]"/>
        </record>
    </data>
</odoo>
