<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_interconectados_sms_wizard_form" model="ir.ui.view">
        <field name="name">interconectados.sms.wizard.form</field>
        <field name="model">interconectados.sms.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar SMS">
                <sheet>

                    <!-- Plantilla opcional -->
                    <group string="Plantilla">
                        <field name="template_id"
                               options="{'no_create': True}"
                               placeholder="Opcional: selecciona una plantilla..."
                               nolabel="1"/>
                    </group>

                    <!-- Destinatario -->
                    <group string="Destinatario(s)">
                        <field name="phone_numbers"
                               nolabel="1"
                               placeholder="04141234567  o  04141234567,04161234567"/>
                        <div class="text-muted" style="font-size:0.85em;">
                            Prefijos validos: 0412, 0414, 0416, 0424, 0426
                        </div>
                    </group>

                    <!-- Mensaje -->
                    <group string="Mensaje">
                        <field name="message"
                               widget="text"
                               nolabel="1"
                               placeholder="Escribe el mensaje o selecciona una plantilla..."
                               style="min-height:90px;"/>
                        <div class="text-muted" style="font-size:0.85em;">
                            <field name="char_count" readonly="1"/> caracteres —
                            <field name="sms_count" readonly="1"/> SMS
                        </div>
                    </group>

                    <!-- Resultado (solo visible despues de enviar) -->
                    <group string="Resultado" invisible="not result_message">
                        <field name="result_message"
                               nolabel="1"
                               readonly="1"
                               style="white-space:pre-wrap;"/>
                    </group>

                    <!-- Campos de credenciales ocultos (se cargan en default_get) -->
                    <field name="api_user" invisible="1"/>
                    <field name="api_password" invisible="1"/>
                    <field name="api_url" invisible="1"/>

                </sheet>
                <footer>
                    <button name="action_send_sms"
                            string="Enviar SMS"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_check_balance"
                            string="Consultar creditos"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_interconectados_sms_wizard" model="ir.actions.act_window">
        <field name="name">Enviar SMS</field>
        <field name="res_model">interconectados.sms.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
