<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST -->
    <record id="view_sms_campaign_list" model="ir.ui.view">
        <field name="name">interconectados.sms.campaign.list</field>
        <field name="model">interconectados.sms.campaign</field>
        <field name="arch" type="xml">
            <list string="Campanas SMS" decoration-success="state == 'done'"
                  decoration-warning="state == 'error'"
                  decoration-info="state == 'scheduled'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state in ('error','running')"
                       decoration-info="state == 'scheduled'"
                       decoration-muted="state == 'draft'"/>
                <field name="valid_count"/>
                <field name="sent_count"/>
                <field name="error_count"/>
                <field name="scheduled_date"/>
                <field name="date_sent"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_sms_campaign_form" model="ir.ui.view">
        <field name="name">interconectados.sms.campaign.form</field>
        <field name="model">interconectados.sms.campaign</field>
        <field name="arch" type="xml">
            <form string="Campana SMS">

                <!-- Barra de estado -->
                <header>
                    <button name="action_process_recipients"
                            string="1. Procesar destinatarios"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft','error')"/>
                    <button name="action_send_now"
                            string="2. Enviar ahora"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft','error')"
                            confirm="Se enviara el SMS a todos los numeros validos. Continuar?"/>
                    <button name="action_schedule"
                            string="Programar envio"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft','error')"/>
                    <button name="action_reset"
                            string="Reiniciar"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('draft','running')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,running,done"/>
                </header>

                <sheet>
                    <!-- Botones estadisticas -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="history_count == 0">
                            <field name="history_count" widget="statinfo" string="Historial"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la campana"/></h1>
                    </div>

                    <!-- Mensaje -->
                    <group string="Mensaje">
                        <field name="template_id"
                               options="{'no_create': True}"
                               placeholder="Opcional: selecciona una plantilla..."/>
                        <field name="message" widget="text" nolabel="1"
                               placeholder="Hola {nombre}, este es tu mensaje..."
                               style="min-height:90px;"
                               readonly="state in ('running','done')"/>
                    </group>

                    <!-- Destinatarios -->
                    <group string="Tipo de destinatarios">
                        <field name="recipient_type" widget="radio"
                               readonly="state in ('running','done')"/>
                    </group>

                    <!-- Manual -->
                    <group string="Numeros manuales"
                           invisible="recipient_type != 'manual'">
                        <field name="phone_numbers_raw" widget="text" nolabel="1"
                               placeholder="04141234567&#10;04161234567&#10;04241234567"
                               style="min-height:80px;"
                               readonly="state in ('running','done')"/>
                        <div class="text-muted">Un numero por linea o separados por coma.</div>
                    </group>

                    <!-- Archivo -->
                    <group string="Cargar archivo"
                           invisible="recipient_type != 'file'">
                        <field name="upload_file" widget="binary"
                               filename="upload_filename"
                               readonly="state in ('running','done')"/>
                        <field name="upload_filename" invisible="1"/>
                        <div class="alert alert-info" role="alert">
                            Sube un archivo <strong>.CSV</strong> o <strong>.TXT</strong>
                            con un numero por fila (o separados por coma).
                            La primera columna se usara como numero de telefono.
                        </div>
                    </group>

                    <!-- Contactos -->
                    <group string="Contactos de Odoo"
                           invisible="recipient_type != 'partners'">
                        <field name="partner_ids" widget="many2many_tags"
                               readonly="state in ('running','done')"/>
                        <field name="partner_domain"
                               placeholder='[["customer_rank","&gt;",0]]'
                               readonly="state in ('running','done')"/>
                        <div class="text-muted">
                            Selecciona contactos manualmente O escribe un filtro.
                            Se usara el numero movil del contacto.
                        </div>
                    </group>

                    <!-- Resumen procesado -->
                    <group string="Resultado del procesado"
                           invisible="not phone_list">
                        <div class="row">
                            <div class="col-3">
                                <div class="text-muted">Total</div>
                                <field name="total_recipients" readonly="1"/>
                            </div>
                            <div class="col-3">
                                <div class="text-success">Validos</div>
                                <field name="valid_count" readonly="1"
                                       style="color:green;font-weight:bold;"/>
                            </div>
                            <div class="col-3">
                                <div class="text-danger">Invalidos</div>
                                <field name="invalid_count" readonly="1"
                                       style="color:red;font-weight:bold;"/>
                            </div>
                        </div>
                        <field name="invalid_detail" widget="text" nolabel="1"
                               readonly="1"
                               invisible="not invalid_detail"
                               style="color:#e74c3c; font-size:0.85em;"/>
                    </group>

                    <!-- Programacion -->
                    <group string="Programar envio automatico">
                        <field name="scheduled"/>
                        <field name="scheduled_date"
                               invisible="not scheduled"
                               readonly="state in ('running','done')"/>
                    </group>

                    <!-- Resultado del envio -->
                    <group string="Resultado del envio"
                           invisible="state not in ('done','error')">
                        <field name="date_sent" readonly="1"/>
                        <field name="sent_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACCION -->
    <record id="action_sms_campaigns" model="ir.actions.act_window">
        <field name="name">Campanas SMS</field>
        <field name="res_model">interconectados.sms.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
