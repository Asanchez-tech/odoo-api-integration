<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sms_template_list" model="ir.ui.view">
        <field name="name">interconectados.sms.template.list</field>
        <field name="model">interconectados.sms.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de SMS">
                <field name="name"/>
                <field name="char_count"/>
                <field name="sms_count"/>
                <field name="model_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sms_template_form" model="ir.ui.view">
        <field name="name">interconectados.sms.template.form</field>
        <field name="model">interconectados.sms.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de SMS">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la plantilla"/></h1>
                    </div>
                    <group>
                        <field name="model_id" placeholder="Opcional: Contacto, Factura..."/>
                        <field name="active"/>
                    </group>
                    <group string="Cuerpo del mensaje">
                        <field name="body" widget="text" nolabel="1"
                               placeholder="Hola {nombre}, tu factura {factura} por Bs. {monto} esta pendiente. Gracias."
                               style="min-height:100px;"/>
                        <div class="alert alert-info" role="alert">
                            <strong>Variables disponibles:</strong>
                            {nombre} {empresa} {telefono} {movil} {monto} {factura} {fecha}
                        </div>
                        <div class="text-muted">
                            <field name="char_count" readonly="1"/> caracteres —
                            <field name="sms_count" readonly="1"/> SMS por envio
                        </div>
                    </group>
                    <group string="Estadisticas">
                        <field name="campaign_count" readonly="1"
                               string="Campanas que usan esta plantilla"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sms_templates" model="ir.actions.act_window">
        <field name="name">Plantillas SMS</field>
        <field name="res_model">interconectados.sms.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
