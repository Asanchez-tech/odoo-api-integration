<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_sms" model="ir.ui.view">
        <field name="name">account.move.form.sms.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Contador de SMS en el stat button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sms_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-comment"
                        invisible="sms_count == 0">
                    <field name="sms_count" widget="statinfo" string="SMS"/>
                </button>
            </xpath>

            <!-- Boton Enviar SMS anclado en el statusbar, estable en Odoo 17/18 -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="before">
                <button name="action_send_sms"
                        string="Enviar SMS"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
